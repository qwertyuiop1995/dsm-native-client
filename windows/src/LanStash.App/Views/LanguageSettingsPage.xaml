<Page
    x:Class="LanStash.App.Views.LanguageSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ScrollViewer>
        <StackPanel
            MaxWidth="720"
            Margin="32"
            HorizontalAlignment="Left"
            Spacing="16">
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" />
            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="FieldLabel" FontWeight="SemiBold" />
                    <ComboBox
                        x:Name="LanguageSelector"
                        MinWidth="260"
                        DisplayMemberPath="DisplayName"
                        SelectionChanged="LanguageSelector_SelectionChanged" />
                    <TextBlock
                        x:Name="NoteText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Spacing="12">
                    <TextBlock
                        x:Name="CloudDriveTitle"
                        Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        x:Name="CloudDriveDescription"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <TextBox x:Name="MappingNameTextBox" />
                    <TextBox
                        x:Name="FolderPathTextBox"
                        Header=""
                        PlaceholderText=""
                        AutomationProperties.Name="" />
                    <ComboBox
                        x:Name="CacheLimitSelector"
                        MinWidth="220"
                        DisplayMemberPath="DisplayName" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            x:Name="CacheDiskText"
                            VerticalAlignment="Center" />
                        <Button
                            x:Name="ChooseCacheDiskButton"
                            Click="ChooseCacheDiskButton_Click" />
                        <Button
                            x:Name="UseDefaultCacheDiskButton"
                            Click="UseDefaultCacheDiskButton_Click"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="AddNasButton"
                            Click="AddNasButton_Click"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            x:Name="AddFolderButton"
                            Click="AddFolderButton_Click" />
                        <ProgressRing
                            x:Name="CloudDriveProgress"
                            Width="20"
                            Height="20"
                            IsActive="False"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <InfoBar
                        x:Name="CloudDriveMessage"
                        IsOpen="False"
                        IsClosable="True" />
                    <StackPanel
                        x:Name="CloudDriveList"
                        Spacing="8" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
