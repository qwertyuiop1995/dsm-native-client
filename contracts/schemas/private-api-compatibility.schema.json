{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "岚仓私有 API 版本兼容索引",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "updatedAt",
    "environments",
    "endpoints"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date"
    },
    "environments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/environment"
      }
    },
    "endpoints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/endpoint"
      }
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(docs|contracts|apple|android|windows|tools)/"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "deviceAlias",
        "baselineStatus",
        "observedAt",
        "dsmVersion",
        "dsmBuild",
        "packages",
        "evidenceRefs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "deviceAlias": {
          "type": "string",
          "pattern": "^lab-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "baselineStatus": {
          "enum": [
            "current",
            "historical"
          ]
        },
        "supersedes": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "observedAt": {
          "type": "string",
          "format": "date"
        },
        "dsmVersion": {
          "type": "string",
          "minLength": 1
        },
        "dsmBuild": {
          "type": "string",
          "minLength": 1
        },
        "dsmUpdate": {
          "type": "string"
        },
        "packages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/package"
          }
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/repositoryPath"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environmentId",
        "evidenceLevel",
        "status",
        "versionMatrix",
        "verifiedAt",
        "evidenceRefs"
      ],
      "properties": {
        "environmentId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "evidenceLevel": {
          "enum": [
            "static",
            "observed",
            "read-verified",
            "behavior-verified",
            "failed"
          ]
        },
        "status": {
          "enum": [
            "candidate",
            "enabled",
            "degraded",
            "disabled",
            "incompatible"
          ]
        },
        "versionMatrix": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "verifiedAt": {
          "type": "string",
          "format": "date"
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/repositoryPath"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "componentId",
        "scope",
        "capability",
        "classification",
        "operation",
        "risk",
        "apiNames",
        "paths",
        "methods",
        "fallback",
        "documentRef",
        "verifications"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "componentId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "enum": [
            "official",
            "internal"
          ]
        },
        "operation": {
          "enum": [
            "read",
            "write",
            "mixed"
          ]
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "apiNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "^(?:https?|wss?)://"
            }
          }
        },
        "methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "GET",
              "POST",
              "WebSocket"
            ]
          }
        },
        "fallback": {
          "type": "string",
          "minLength": 1
        },
        "documentRef": {
          "$ref": "#/$defs/repositoryPath"
        },
        "verifications": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/verification"
          }
        }
      }
    }
  }
}
