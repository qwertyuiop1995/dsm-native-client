{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dsm-native-client/request-fixture.schema.json",
  "title": "RequestFixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "fixtureId",
    "module",
    "operation",
    "api",
    "transport",
    "parameters",
    "authentication",
    "policy",
    "source"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "fixtureId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "module": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "operation": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[A-Z][a-z0-9]*)*$"
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "method",
        "preferredVersion",
        "resolvedVersion",
        "resolvedPath"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^SYNO\\.[A-Za-z0-9_.]+$"
        },
        "method": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9_]{0,79}$"
        },
        "preferredVersion": {
          "type": "integer",
          "minimum": 1
        },
        "resolvedVersion": {
          "type": "integer",
          "minimum": 1
        },
        "resolvedPath": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]+\\.cgi$"
        }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["httpMethod", "requestFormat"],
      "properties": {
        "httpMethod": {
          "enum": ["GET", "POST"]
        },
        "requestFormat": {
          "enum": ["form", "json", "multipart"]
        }
      }
    },
    "parameters": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "valueType"],
        "oneOf": [
          {
            "required": ["encodedValue"],
            "not": {
              "required": ["redacted"]
            }
          },
          {
            "required": ["redacted"],
            "not": {
              "required": ["encodedValue"]
            }
          }
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,79}$"
          },
          "valueType": {
            "enum": [
              "string",
              "integer",
              "boolean",
              "binary",
              "stringArray",
              "integerArray",
              "object",
              "objectArray"
            ]
          },
          "encodedValue": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "redacted": {
            "const": true
          }
        }
      }
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "synoTokenRequired",
        "sessionLocations",
        "synoTokenLocations"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "synoTokenRequired": {
          "type": "boolean"
        },
        "sessionLocations": {
          "type": "array",
          "items": {
            "enum": ["cookie", "query", "form", "json", "multipart"]
          },
          "uniqueItems": true
        },
        "synoTokenLocations": {
          "type": "array",
          "items": {
            "enum": ["header", "query", "form", "json", "multipart"]
          },
          "uniqueItems": true
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retryPolicy", "risk", "readbackPolicy"],
      "properties": {
        "retryPolicy": {
          "enum": [
            "never",
            "readOnlyAutomatic",
            "queryStateBeforeDecision"
          ]
        },
        "risk": {
          "enum": ["read", "standardWrite", "highRisk", "destructive"]
        },
        "readbackPolicy": {
          "enum": ["none", "required", "taskPoll", "unavailable"]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "evidence"],
      "properties": {
        "kind": {
          "const": "synthetic"
        },
        "evidence": {
          "enum": [
            "publicDocumentation",
            "sourceReviewed",
            "redactedDiscoveryRecord"
          ]
        }
      }
    }
  }
}
