<Page
    x:Class="LanStash.App.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:domain="using:LanStash.Domain"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid Padding="40">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="32" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Image
                    Width="56"
                    Height="56"
                    AutomationProperties.AccessibilityView="Raw"
                    Source="ms-appx:///Assets/AppIcon.png"
                    Stretch="UniformToFill" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="岚仓" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="管理你的 NAS" />
                </StackPanel>
            </StackPanel>
            <Button
                HorizontalAlignment="Stretch"
                Click="NewProfile_Click"
                Content="添加 NAS"
                Style="{StaticResource AccentButtonStyle}" />
            <ListView
                x:Name="ProfileList"
                AutomationProperties.Name="已保存的 NAS"
                ItemsSource="{Binding Profiles}"
                SelectionChanged="ProfileList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="domain:NasProfile">
                        <Grid Padding="4,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="20"
                                Glyph="&#xEDA2;" />
                            <StackPanel Grid.Column="1">
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayName}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Host}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <Border
            Grid.Column="2"
            MaxWidth="620"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Padding="32"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="16">
            <StackPanel Spacing="18">
                <StackPanel>
                    <TextBlock Text="连接 NAS" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="使用 DSM 账号登录；你可以选择在这台电脑上安全保存密码。" />
                </StackPanel>
                <TextBox
                    Header="名称"
                    Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox
                    Header="NAS 地址或 QuickConnect ID"
                    PlaceholderText="nas.example.com 或你的 QuickConnect ID"
                    Text="{Binding Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox
                    Header="用户名"
                    Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <PasswordBox x:Name="PasswordInput" Header="密码" PasswordRevealMode="Peek" />
                <PasswordBox x:Name="OtpInput" Header="验证码（如需要）" PasswordRevealMode="Peek" />
                <CheckBox
                    Content="在这台电脑上记住密码"
                    IsChecked="{Binding RememberPassword, Mode=TwoWay}" />
                <TextBlock
                    Margin="28,-14,0,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="密码由 Windows 凭据管理器安全保护。"
                    TextWrapping="Wrap" />
                <CheckBox
                    Content="自动登录"
                    IsChecked="{Binding AutoLogin, Mode=TwoWay}" />
                <TextBlock
                    Margin="28,-14,0,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="下次打开岚仓时自动连接这台 NAS。"
                    TextWrapping="Wrap" />
                <Expander Header="高级连接设置">
                    <StackPanel Padding="0,10,0,0" Spacing="6">
                        <TextBox
                            Header="自定义 HTTPS 端口"
                            InputScope="Number"
                            PlaceholderText="自动选择"
                            Text="{Binding Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="留空时由岚仓自动选择；填写后优先使用这个端口。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>
                <InfoBar
                    x:Name="ErrorBar"
                    IsClosable="False"
                    IsOpen="False"
                    Message="{Binding ErrorMessage}"
                    Severity="Error" />
                <InfoBar
                    x:Name="StatusBar"
                    IsClosable="False"
                    IsOpen="False"
                    Message="{Binding ConnectionStatus}"
                    Severity="Informational" />
                <Grid>
                    <Button
                        x:Name="ConnectButton"
                        MinWidth="120"
                        HorizontalAlignment="Right"
                        Click="Connect_Click"
                        Content="连接"
                        Style="{StaticResource AccentButtonStyle}" />
                    <ProgressRing
                        x:Name="BusyIndicator"
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Left"
                        IsActive="False" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Page>
