<Page
    x:Class="LanStash.App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <NavigationView
        x:Name="Navigation"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="True"
        PaneDisplayMode="Auto"
        SelectionChanged="Navigation_SelectionChanged">
        <NavigationView.PaneHeader>
            <StackPanel Margin="4,8,0,12">
                <TextBlock x:Name="AppNameText" FontSize="20" FontWeight="SemiBold" />
                <TextBlock
                    x:Name="ProfileName"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </NavigationView.PaneHeader>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem x:Name="LogoutItem" Icon="Account" />
        </NavigationView.FooterMenuItems>
        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Page>
