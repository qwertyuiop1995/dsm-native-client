{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "岚仓社区兼容性报告 / LanStash Community Compatibility Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "reportId",
    "sourceRef",
    "submittedAt",
    "reviewStatus",
    "app",
    "nas",
    "dsm",
    "packages",
    "connectionType",
    "accountRole",
    "certificateType",
    "testSuiteVersion",
    "results",
    "privacyAttestation"
  ],
  "properties": {
    "$schema": {
      "const": "../../schemas/community-compatibility-report.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "reportId": {
      "type": "string",
      "pattern": "^cc-[0-9]{6}$"
    },
    "sourceRef": {
      "type": "string",
      "pattern": "^(?:issue|pull)-[1-9][0-9]*$"
    },
    "submittedAt": {
      "type": "string",
      "format": "date"
    },
    "reviewStatus": {
      "enum": [
        "submitted",
        "reviewed",
        "corroborated",
        "maintainer-verified",
        "disputed",
        "superseded"
      ]
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "platform",
        "platformVersion"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "platform": {
          "enum": [
            "macOS",
            "iPhone",
            "iPad",
            "Android",
            "Windows"
          ]
        },
        "platformVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      }
    },
    "nas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "architecture"
      ],
      "properties": {
        "model": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9+._-]{1,39}$"
        },
        "architecture": {
          "enum": [
            "x86_64",
            "aarch64",
            "armv7",
            "unknown"
          ]
        }
      }
    },
    "dsm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "build",
        "update"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$"
        },
        "build": {
          "type": "string",
          "pattern": "^[0-9]{4,8}$"
        },
        "update": {
          "type": "string",
          "pattern": "^(?:[0-9]{1,3}|none|unknown)$"
        }
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        }
      }
    },
    "connectionType": {
      "enum": [
        "lan",
        "quickconnect-direct",
        "quickconnect-relay",
        "reverse-proxy",
        "unknown"
      ]
    },
    "accountRole": {
      "enum": [
        "standard",
        "administrator",
        "unknown"
      ]
    },
    "certificateType": {
      "enum": [
        "public-ca",
        "private-ca",
        "self-signed",
        "unknown"
      ]
    },
    "testSuiteVersion": {
      "const": 1
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capabilityId",
          "status"
        ],
        "properties": {
          "capabilityId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "partial",
              "skipped",
              "not-supported"
            ]
          },
          "failureCategory": {
            "enum": [
              "permission-denied",
              "operation-failed",
              "connection-failed",
              "unexpected-result",
              "app-crashed",
              "unknown"
            ]
          }
        }
      }
    },
    "privacyAttestation": {
      "const": true
    }
  }
}
