<Page
    x:Class="LanStash.App.Views.LanguageSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ScrollViewer>
        <StackPanel
            MaxWidth="720"
            Margin="32"
            HorizontalAlignment="Left"
            Spacing="16">
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" />
            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="FieldLabel" FontWeight="SemiBold" />
                    <ComboBox
                        x:Name="LanguageSelector"
                        MinWidth="260"
                        DisplayMemberPath="DisplayName"
                        SelectionChanged="LanguageSelector_SelectionChanged" />
                    <TextBlock
                        x:Name="NoteText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
