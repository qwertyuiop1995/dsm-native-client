{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "岚仓社区兼容性报告 / LanStash Community Compatibility Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "reportId",
    "sourceRef",
    "submittedAt",
    "reviewStatus",
    "app",
    "nas",
    "dsm",
    "packages",
    "connectionType",
    "accountRole",
    "certificateType",
    "testSuiteVersion",
    "results",
    "privacyAttestation"
  ],
  "properties": {
    "$schema": {
      "const": "../../schemas/community-compatibility-report.schema.json"
    },
    "schemaVersion": {
      "const": 2
    },
    "reportId": {
      "type": "string",
      "pattern": "^cc-[0-9]{6}$"
    },
    "sourceRef": {
      "type": "string",
      "pattern": "^(?:issue|pull)-[1-9][0-9]*$"
    },
    "submittedAt": {
      "type": "string",
      "format": "date"
    },
    "reviewStatus": {
      "enum": [
        "submitted",
        "reviewed",
        "corroborated",
        "maintainer-verified",
        "disputed",
        "superseded"
      ]
    },
    "supersedes": {
      "description": "由维护者填写的新报告所取代的旧报告 ID；本地提交草稿不得生成此字段。",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^cc-[0-9]{6}$"
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "commit",
        "platform",
        "platformVersion"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "commit": {
          "type": "string",
          "pattern": "^(?:[0-9a-fA-F]{7,40}|unknown)$"
        },
        "platform": {
          "enum": [
            "macOS",
            "iPhone",
            "iPad",
            "Android",
            "Windows"
          ]
        },
        "platformVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      }
    },
    "nas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "architecture"
      ],
      "properties": {
        "model": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9+._-]{1,39}$"
        },
        "architecture": {
          "enum": [
            "x86_64",
            "aarch64",
            "armv7",
            "unknown"
          ]
        }
      }
    },
    "dsm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "build",
        "update"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$"
        },
        "build": {
          "type": "string",
          "pattern": "^[0-9]{4,8}$"
        },
        "update": {
          "type": "string",
          "pattern": "^(?:[0-9]{1,3}|none|unknown)$"
        }
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        }
      }
    },
    "connectionType": {
      "enum": [
        "lan",
        "quickconnect-direct",
        "quickconnect-relay",
        "reverse-proxy",
        "unknown"
      ]
    },
    "accountRole": {
      "enum": [
        "standard",
        "administrator",
        "unknown"
      ]
    },
    "certificateType": {
      "enum": [
        "public-ca",
        "private-ca",
        "self-signed",
        "unknown"
      ]
    },
    "testSuiteVersion": {
      "description": "报告必须包含该测试套件版本引入的全部能力；未执行的能力也要明确标记为 skipped 或 not-supported。",
      "enum": [
        1,
        2
      ]
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capabilityId",
          "status"
        ],
        "properties": {
          "capabilityId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "partial",
              "skipped",
              "not-supported"
            ]
          },
          "failure": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage",
              "errorCategory",
              "apiName",
              "apiVersion",
              "httpStatus",
              "retryPerformed",
              "rawResponseIncluded"
            ],
            "properties": {
              "stage": {
                "enum": [
                  "setup",
                  "discovery",
                  "authentication",
                  "request",
                  "submission",
                  "readback",
                  "final-state",
                  "cleanup",
                  "unknown"
                ]
              },
              "errorCategory": {
                "enum": [
                  "permission-denied",
                  "operation-failed",
                  "connection-failed",
                  "unexpected-result",
                  "app-crashed",
                  "unknown"
                ]
              },
              "apiName": {
                "type": "string",
                "pattern": "^(?:SYNO(?:\\.[A-Za-z0-9_]+)+|unknown)$"
              },
              "apiVersion": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 99
                  },
                  {
                    "const": "unknown"
                  }
                ]
              },
              "httpStatus": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 599
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "retryPerformed": {
                "type": "boolean"
              },
              "rawResponseIncluded": {
                "const": false
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "failed",
                    "partial"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "failure"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "failure"
                ]
              }
            }
          }
        ]
      }
    },
    "privacyAttestation": {
      "const": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "testSuiteVersion": {
            "const": 1
          }
        },
        "required": [
          "testSuiteVersion"
        ]
      },
      "then": {
        "properties": {
          "results": {
            "minItems": 14,
            "maxItems": 14
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "testSuiteVersion": {
            "const": 2
          }
        },
        "required": [
          "testSuiteVersion"
        ]
      },
      "then": {
        "properties": {
          "results": {
            "minItems": 19,
            "maxItems": 19
          }
        }
      }
    }
  ]
}
